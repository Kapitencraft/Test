package test;

class SumTest {

    static void main(String[] args) {
        System.print(sum(50));
        System.print(quadSum(50));
    }

    static int sum(int n) {
        int sum = 0;
        for (int i = 1; i <= n; i++) {
            sum += i;
        }
        return sum;
    }

    static int quadSum(int n) {
        int sum = 0;
        for (int i = 0; i <= n; i++) {
            sum += i**2;
        }
        return sum;
    }
}